# Kopier til .env og fyll inn. .env er gitignorert.

# ── Lab 1 (lokalt) ───────────────────────────────────────────────────────────
# Klassisk personal access token med bare scopet public_repo.
# Du må ha godtatt collaborator-invitasjonen til novanet/workshop.oslo-live.
# Fine-grained tokens funker ikke for collaborators utenfor Novanet-orgen.
GH_TOKEN=ghp_...

# Den eneste deltaker-spesifikke verdien. Bruk et unikt navn, for eksempel
# kari: 3-12 tegn, små bokstaver, tall og bindestrek, start med bokstav.
# Det brukes i commits, PR-er, Azure-navn og ACR-bilder.
AGENT_NAME=

# API-nøkkel fra kursets Anthropic-workspace. Kurslederen leverer den med kostnadstak.
# Claude.ai-abonnement og Anthropic API-betaling er separate; du skal normalt ikke betale selv.
ANTHROPIC_API_KEY=sk-ant-...

# Standard workspace for kurset. API-nøkkelen må fortsatt komme fra kurslederen
# og ha tilgang til dette workspace-et.
ANTHROPIC_WORKSPACE_ID=wrkspc_017LSdCTfnAddrQcuKrM38Aq

# Valgfritt. Hvor repoet klones lokalt. Standard er en mappe under temp.
# WORKSPACE=/tmp/mini-nils

# Valgfritt. Full sti til claude-kommandoen hvis workeren ikke finner den selv.
# CLAUDE_CMD=/usr/local/bin/claude

# Valgfritt. Skriv Claude Code sine verbose-diagnoser fortløpende i worker-loggen.
# Bruk CLAUDE_VERBOSE=true ved feilsøking; standard er av.
# CLAUDE_VERBOSE=false

# Valgfritt. Hvor agentens hukommelse ligger. Standard er agent/memory.md,
# ved siden av system.md. I Azure brukes en blob i stedet, se Lab 3.
# MEMORY_PATH=agent/memory.md

# Valgfritt. Hvor mange tegn hukommelsen får bli før de eldste oppføringene
# kuttes. Standard er 6000, omtrent 1500 tokens per kjøring.
# MEMORY_MAX_CHARS=6000

# ── Lab 2 (Azure) ────────────────────────────────────────────────────────────
# GitHub Actions derives the Azure resource suffix from AGENT_NAME and uses the
# fixed course resource group, registry, pull identity, and norwayeast region.
# Azure deployment does not use this file; the workflow reads repository secrets.

# Webhook-hemmelighet. Kurslederen provisionerer den som repository secret og
# bruker samme verdi ved registrering i Oslo Live. Ikke kopier den inn her for
# Azure-deploy; workflowen leser WEBHOOK_SECRET fra GitHub Actions.
WEBHOOK_SECRET=

# Valgfritt. Overstyrer standardmodellen i agent/stages.json for alle steg
# som ikke har satt sin egen.
# CLAUDE_MODEL=claude-sonnet-5


# Flere agenter kan arbeide på samme issue. Første mergete PR vinner;
# Sensor avviser konkurrerende åpne PR-er etterpå.

# Settes av .github/deploy-azure.sh i Azure. Trengs bare hvis du kjører
# kømodus lokalt.
# QUEUE_CONNECTION=
# QUEUE_NAME=agent-tasks
# MEMORY_CONNECTION=
# RUNS_TABLE=agentRuns

# Repoet agenten får jobbe i. Mottak og worker avviser alle andre repoer.
# TARGET_REPO=novanet/workshop.oslo-live

# Valgfritt og eksperimentelt. GitHub-loginet som eier GH_TOKEN, uten @.
# Agenten svarer når noen andre skriver @<login> i en PR-kommentar; sine egne
# kommentarer ignorerer den. Når dette er satt, registrerer webhook-skriptet
# også PR-kommentarer og review-tråder. Eksempel: AGENT_MENTION=kari-hansen
AGENT_MENTION=
